# Public site URL (no trailing slash) - used for canonical, sitemap, hreflang, Open Graph.
# Set this to the real domain in production, otherwise absolute URLs point to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form. Without all three, the form returns an error in production
# (in development the enquiry is only logged to the console).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cookieless analytics - disabled when empty, so no cookie banner is needed.
#   plausible: PROVIDER=plausible, DOMAIN=your-domain.com (SRC only if self-hosted)
#   umami:     PROVIDER=umami,     DOMAIN=<website id>,    SRC=<script url>
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
